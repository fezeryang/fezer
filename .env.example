# ===== Required (server) =====
DATABASE_URL=mysql://root:password@127.0.0.1:3306/kinetic_portfolio
JWT_SECRET=replace_with_32_plus_chars_random_secret
OAUTH_SERVER_URL=https://oauth.example.com
OWNER_OPEN_ID=replace_with_owner_openid

# ===== Required (frontend) =====
VITE_APP_ID=replace_with_oauth_app_id
VITE_OAUTH_PORTAL_URL=https://oauth.example.com

# ===== Optional =====
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local development fallbacks (non-production only)
LOCAL_ADMIN_AUTH_BYPASS=false
LOCAL_CONTENT_IN_MEMORY_FALLBACK=false

# Maps / analytics (optional)
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
